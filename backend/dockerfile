# 1. Base Image
# Se mantiene la base ligera de Python 3.11.
FROM python:3.11-slim

# 2. Environment Variable (Opcional, pero buena práctica)
# Configura Python para que no escriba archivos .pyc en el disco y use un buffer de salida directo.
ENV PYTHONUNBUFFERED 1

# 3. Working Directory
# Define el directorio de trabajo dentro del contenedor.
# Reemplaza "/the/workdir/path" por un nombre más específico (ej. /app).
WORKDIR /app

# 4. Install System Dependencies & Python Packages
# La mejor práctica es COPIAR el archivo requirements.txt PRIMERO
# para aprovechar el cache de Docker.

# COPIA SÓLO el archivo de requisitos.
COPY requirements.txt .

# Instala dependencias del sistema necesarias para compilar paquetes
# con dependencias nativas (como psycopg2 para PostgreSQL).
# ¡ATENCIÓN!: Es mejor usar una imagen base basada en Debian/Ubuntu (ej. python:3.11-slim-buster)
# si quieres usar 'apt-get' o si 'apk' (usado en 'slim') te da problemas.
# 'python:3.11-slim' está basado en Debian, por lo que 'apk' NO es el gestor
# de paquetes correcto. Deberías usar 'apt-get'.

# **Corrección para python:3.11-slim (basado en Debian):**
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Instala las dependencias de Python.
# Si estás usando `psycopg2-binary` en `requirements.txt`, no necesitarías `gcc` y `libpq-dev` en la imagen final.
# Pero si usas `psycopg2` (que requiere compilación), las dependencias del sistema son necesarias.
RUN pip install --no-cache-dir -r requirements.txt

# 5. Application Code
# COPIA el resto del código de la aplicación.
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
COPY . .

# 6. Expose Port (Opcional, para documentación)
# Aunque Django correrá en 8000, esto solo documenta el puerto.
EXPOSE 8000

# 7. Default Command
# Comando que se ejecuta al iniciar el contenedor.
# Es buena práctica usar un script de inicio o el comando 'gunicorn' o 'uWSGI' para producción.
# Para desarrollo, este es suficiente.
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]