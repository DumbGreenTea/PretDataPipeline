# Example environment variables for development using docker-compose
POSTGRES_DB=poddb
POSTGRES_USER=poduser
POSTGRES_PASSWORD=podpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Alternatively use a DATABASE_URL
# DATABASE_URL=postgres://poduser:podpassword@db:5432/poddb

# Django
# SECRET_KEY should be a long random string in production
SECRET_KEY=replace-this-for-dev
DEBUG=True

# ¿Para que es esto? 
LANDING_INBOX=./landing/inbox
LANDING_PROCESSED=./landing/processed
LANDING_REJECTED=./landing/rejected

POD_SHEET_NAME=Asistencia
POD_HEADER_ROW=0
# "Excel->estándar"
POD_MAP=Fecha:fecha,RUT:rut,Contrato:contrato,CC:centro_costo,HH:hh