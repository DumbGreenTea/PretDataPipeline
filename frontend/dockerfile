# Development Dockerfile for Next.js app
# Uses the development server (npm run dev) and expects a bind mount for hot reload.
FROM node:18-alpine

# Create app directory
WORKDIR /app_web

# Install build-time dependencies (if any). Keep package.json copies limited for caching.
COPY app_web/package*.json ./

# Install all dependencies (including devDependencies) so `next dev` can run inside the container.
RUN npm install

# Copy application source
COPY app_web/ ./

# Development env
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Port used by Next.js dev server
EXPOSE 3000

# Default command runs the Next dev server. For live reload, run the container with a bind mount
# from your host project directory to /app_web (e.g. using docker-compose or `-v $(pwd)/frontend/app_web:/app_web`).
CMD ["npm", "run", "dev"]